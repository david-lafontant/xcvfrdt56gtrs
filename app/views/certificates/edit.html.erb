<% if ['admin', 'sysadmin'].include?(current_user.role)  %>
  <% content_for :title, "Editing certificate" %>
  <main class="form-devise w-100 m-auto">
  <h1>Editing certificate</h1>

  <%= render "form", certificate: @certificate %>

  <br>

  <div>
    <%= link_to "Show this certificate", @certificate %> |
    <%= link_to "Back to certificates", certificates_path %>
  </div>
  </main>
<%end%>
