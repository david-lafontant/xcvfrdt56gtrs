<%= form_with(model: certificate) do |form| %>
  <% if certificate.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(certificate.errors.count, "error") %> prohibited this certificate from being saved:</h2>

      <ul>
        <% certificate.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-floating">
    <%= form.text_field :first_name, class: "form-control" %>
    <%= form.label :first_name  %>
  </div>

  <div class="form-floating">
    <%= form.text_field :last_name, class: "form-control" %>
    <%= form.label :last_name %>
  </div>

  <div class="form-floating">
    <%= form.label :company %>
    <%= form.text_field :company, class: "form-control" %>
  </div>

  <div class="form-floating">
    <%= form.label :certificate_id %>
    <%= form.text_field :certificate_id, class: "form-control" %>
  </div>

  <div class="form-floating mb-3">
    <%= form.label :description, "Description des materiels" %>
    <%= form.textarea :description, class: "form-control" %>
  </div>

  <div class="form-floating">
    <%= form.label :documents , class: "opacity-0"%>
    <%= form.file_field :documents, multiple: true, class: "form-control" %>
  </div>

  <div>
    <%= form.submit "Creer certificat", class: "btn btn-success w-100" %>
  </div>
<% end %>
