
<% if ['admin', 'sysadmin'].include?(current_user.role)  %>
<% content_for :title, "Certificates" %>
<div class="container">
<p style="color: green"><%= notice %></p>

<%= link_to "New certificate", new_certificate_path, class: "btn btn-primary" %>

<h1>Certificates</h1>

  <div id="certificates">
    <table class="table table-warning table-striped-columns table-hover certificate-table">
      <thead>
        <th scope="col">Responsable</th>
        <th scope="col">ID</th>
        <th scope="col">Details</th>
      </thead>
      <tbody>
        <% @certificates.each do |certificate| %>
          <tr>
          <td>
            <%= certificate.first_name %>&nbsp;<%= certificate.last_name %>
          </td>

          <td>
            <%= certificate.certificate_id %>
          </td>
        
          <td>
            <%= link_to "Show this certificate", certificate, class: "btn-btn-primary" %>
          </td>
          </tr>
    
        <% end %>
      </tbody>
    </table>
  </div>

</div>
<%end%>