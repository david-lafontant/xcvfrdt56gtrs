<p style="color: green"><%= notice %></p>

<div class="container p-4">
  <div class="row my-3">
    <div class="col col-md-6 mx-auto">
      <div class="card">

      <%= render @certificate %>
        <% if ['admin', 'sysadmin'].include?(current_user.role)  %>
          <div  class="card-footer">
            <%= link_to "Edit this certificate", edit_certificate_path(@certificate), class: "btn btn-warning" %> |
            <%= link_to "Back to certificates", certificates_path, class: "btn btn-primary" %>
            <% if current_user.sysadmin? %>
              <%= button_to "Destroy this certificate", @certificate, method: :delete, class: "btn btn-danger mt-2" %>
            <%end%>
          </div>
        <%end%>
      </div>
    </div>
  </div>
</div>
